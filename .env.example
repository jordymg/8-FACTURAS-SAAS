# Config para desarrollo LOCAL. Copiar a .env y completar.
# (La config de producción del VPS vive en /etc/facturas-saas/env — ver
#  docs/ops/vps.md. En producción se agrega PRODUCTION=true para la cookie Secure.)

# Requeridas
SECRET_KEY=change-me-generate-with-python-secrets
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Credenciales de la Service Account que escribe en los Sheets: archivo JSON
# fuera del repo (ej. en instance/, gitignored). Alternativa en producción:
# el JSON inline en GOOGLE_SA_CREDENTIALS_JSON (ver app/services/sheets.py).
GOOGLE_SA_CREDENTIALS_FILE=instance/service-account.json

# Opcionales (con default en el código)
# GEMINI_MODEL=gemini-flash-latest
# DATABASE_URL=sqlite:///app.db
# LOG_TIEMPOS=true
